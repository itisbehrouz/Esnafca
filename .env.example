# Environment Configuration for Esnafça

# App
NODE_ENV=development
PORT=3005

# Database (Development: SQLite, Production: PostgreSQL / Supabase / Neon)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/esnafca?schema=public&sslmode=require"

# Security & JWT
JWT_SECRET="generate-a-secure-random-64-character-string-for-production"
ADMIN_PASSWORD="esnafca2026!"

# Storage (local, supabase, r2)
STORAGE_PROVIDER="local"
UPLOAD_DIR="public/uploads"
STORAGE_PUBLIC_URL="/uploads"
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Payments (Phase 2 - mock, iyzico, paytr)
PAYMENT_PROVIDER="mock"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# Shared secret /api/payments/webhook requires on every call (header: x-webhook-secret).
# Required in production — the app refuses to start without it.
PAYMENT_WEBHOOK_SECRET=""

# Private Preview Mode (Site-wide password gatekeeper)
# If set to a non-empty string, locks all public pages behind /preview-gate
SITE_PASSWORD=""
SITE_ACCESS_COOKIE="esnaf_preview_session"
