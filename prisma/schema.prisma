datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Merchant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  craftTitle      String
  masterName      String
  category        String
  city            String
  district        String
  neighborhood    String
  address         String
  latitude        Float?
  longitude       Float?
  phone           String
  whatsapp        String
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(false)
  verifiedYear    Int?
  tier            String   @default("free") // "free", "pro", "plus"
  experienceYears Int      @default(0)
  minPrice        Float    @default(0)
  maxPrice        Float    @default(0)
  priceNote       String?
  
  // Native JSON types for PostgreSQL
  workingHours    Json
  heroImage       String
  galleryImages   Json
  bio             String
  specialties     Json
  features        Json
  
  isOpenNow       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services        ServiceItem[]
  reviews         Review[]
  appointments    Appointment[]
}

model ServiceItem {
  id                String   @id @default(cuid())
  merchantId        String
  name              String
  description       String?
  minPrice          Float
  maxPrice          Float?
  isStartingPrice   Boolean  @default(false)
  estimatedDuration String?
  popular           Boolean  @default(false)
  requiresDeposit   Boolean  @default(false)
  depositAmount     Float?
  isArchived        Boolean  @default(false)

  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
}

model Review {
  id               String   @id @default(cuid())
  merchantId       String
  author           String
  profession       String?
  rating           Int
  date             String
  comment          String
  tags             String   // JSON string array
  verifiedCustomer Boolean  @default(false)

  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantApplication {
  id              String   @id @default(cuid())
  name            String
  masterName      String
  category        String
  experienceYears Int?
  city            String
  district        String
  neighborhood    String
  address         String
  latitude        Float?
  longitude       Float?
  phone           String
  whatsapp        String
  plan            String
  services        String   // JSON string
  status          String   @default("pending") // pending, approved, rejected
  createdAt       DateTime @default(now())
}

model Appointment {
  id            String       @id @default(cuid())
  merchantId    String
  serviceId     String?
  customerName  String
  customerPhone String
  customerNote  String?
  date          String       // Format: YYYY-MM-DD
  startTime     String       // Format: HH:mm, e.g., "14:30"
  endTime       String?      // Format: HH:mm
  price         Float
  status        String       @default("pending") // "pending", "confirmed", "completed", "cancelled"
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  merchant      Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  service       ServiceItem? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([merchantId, date, startTime])
}

model OtpVerification {
  id         String   @id @default(cuid())
  phone      String   @unique
  tokenHash  String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
}
